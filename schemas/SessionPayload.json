{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/SessionPayload.json",
  "title": "SessionPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "task_id",
    "source_type",
    "source_path",
    "created_utc"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Schema version string, e.g., v1"
    },
    "session_id": {
      "type": "string",
      "description": "UUID for this capture session",
      "minLength": 8
    },
    "task_id": {
      "type": "string",
      "description": "Stable identifier for the user task/activity",
      "minLength": 1
    },
    "source_type": {
      "type": "string",
      "description": "Which adapter produced the payload",
      "enum": ["reading", "transcript", "code"]
    },
    "source_path": {
      "type": "string",
      "description": "Original file path or source reference",
      "minLength": 1
    },
    "created_utc": {
      "type": "string",
      "description": "ISO-8601 UTC timestamp",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
    },
    "notes": {
      "type": ["string", "null"],
      "description": "Optional notes for debugging or annotation"
    }
  }
}
